# Everything generated lives under build/ and dist/ (build.bat, verify.bat, dist.bat and the dev runs).
/build/
/dist/

# Generated files anywhere else are never tracked either.
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.map
*.res
*.ico
*.log
*.zip
*.png
!/docs/images/*.png
!/docs/images/themes/*.png

# Editor and Windows files.
.vs/
.vscode/
*.user
*.suo
Thumbs.db
desktop.ini
.claude/settings.local.json
